# Copy to .env and adjust. .env is not committed.
# Load it into your shell before running: set -a; source .env; set +a
DATABASE_URL='postgres://jobalert:jobalert@localhost:5432/jobalert?sslmode=disable'
# How often to check the job boards, as a Go duration (24h, 6h, 30m). Default 24h.
SCHEDULE_INTERVAL=24h
# How many companies are checked at the same time. Default 5.
CONCURRENCY=5
